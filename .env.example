ENVIRONMENT=development
DATABASE_URL=sqlite:///./noka.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Independent workload models. OPENAI_MODEL above is used by Scout research.
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_GUIDE_MODEL=gpt-6-sol
TAVILY_API_KEY=
INGESTION_SECRET=
PORT=8000
PUBLIC_ORIGIN=

# Bounded read-only Matchmaker (optional; key stays server-side)
AGENT_MAX_TOOLS=5
AGENT_MAX_TURNS=4
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_DAILY_QUOTA=20
AGENT_MAX_CONCURRENT=2
AGENT_GLOBAL_CONCURRENT=8
